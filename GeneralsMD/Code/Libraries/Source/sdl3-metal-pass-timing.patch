+// Optional stage-boundary timestamps for render encoders (Apple tile GPUs).
+// Buckets: 0=unlabelled, 1=scene, 2=intermediate, 3=depth-only;
+// 4=FFT, 5=heat, 6=MSAA, 7=native particles, 8=post, 9=smoke shadow,
+// 10=gamma, 11=MSAA depth, 12=AO, 13=atmosphere, 14=firelight,
+// 15=MSAA depth clear.
+// The engine labels its passes just before SDL_BeginGPURenderPass.
+static __thread Uint32 ZH_MetalNextRenderPassTag;
+static Uint64 ZH_MetalPassNs[16];
+static Uint64 ZH_MetalPassMaxNs[16];
+static Uint32 ZH_MetalPassCount[16];
+static Uint32 ZH_MetalPassMissing[16];
+static Uint64 ZH_MetalFragmentInvocations[16];
+static Uint64 ZH_MetalFragmentsPassed[16];
+static Uint32 ZH_MetalStatisticsCount[16];
+static Uint32 ZH_MetalStatisticsMissing[16];
+// GPU counter timestamps use the device clock, not necessarily nanoseconds.
+// Calibrate once from paired GPU/CPU samples at least 250ms apart. Apple
+// documents the CPU timestamps returned by sampleTimestamps as nanoseconds.
+static Uint64 ZH_MetalCalibrationStartCpu;
+static Uint64 ZH_MetalCalibrationStartGpu;
+static Uint64 ZH_MetalCalibrationStartWall;
+static double ZH_MetalNanosecondsPerGpuTick;
+
+void ZH_SDL_Metal_GetTimestampScale(double *scale)
+{
+    SDL_LockSpinlock(&ZH_MetalTimingLock);
+    if (scale) *scale = ZH_MetalNanosecondsPerGpuTick;
+    SDL_UnlockSpinlock(&ZH_MetalTimingLock);
+}
+
+void ZH_SDL_Metal_SetNextRenderPassTag(Uint32 category)
+{
+    ZH_MetalNextRenderPassTag = category < 16 ? category : 0;
+}
+
+void ZH_SDL_Metal_TakePassTiming(Uint64 *ns, Uint64 *maxNs,
+                                 Uint32 *count, Uint32 *missing)
+{
+    SDL_LockSpinlock(&ZH_MetalTimingLock);
+    for (unsigned i=0; i<16; ++i) {
+        if (ns) ns[i] = ZH_MetalPassNs[i];
+        if (maxNs) maxNs[i] = ZH_MetalPassMaxNs[i];
+        if (count) count[i] = ZH_MetalPassCount[i];
+        if (missing) missing[i] = ZH_MetalPassMissing[i];
+        ZH_MetalPassNs[i] = ZH_MetalPassMaxNs[i] = 0;
+        ZH_MetalPassCount[i] = ZH_MetalPassMissing[i] = 0;
+    }
+    SDL_UnlockSpinlock(&ZH_MetalTimingLock);
+}
+
+void ZH_SDL_Metal_TakeFragmentStatistics(Uint64 *fragmentInvocations,
+                                          Uint64 *fragmentsPassed,
+                                          Uint32 *count, Uint32 *missing)
+{
+    SDL_LockSpinlock(&ZH_MetalTimingLock);
+    for (unsigned i=0; i<16; ++i) {
+        if (fragmentInvocations) fragmentInvocations[i] = ZH_MetalFragmentInvocations[i];
+        if (fragmentsPassed) fragmentsPassed[i] = ZH_MetalFragmentsPassed[i];
+        if (count) count[i] = ZH_MetalStatisticsCount[i];
+        if (missing) missing[i] = ZH_MetalStatisticsMissing[i];
+        ZH_MetalFragmentInvocations[i] = ZH_MetalFragmentsPassed[i] = 0;
+        ZH_MetalStatisticsCount[i] = ZH_MetalStatisticsMissing[i] = 0;
+    }
+    SDL_UnlockSpinlock(&ZH_MetalTimingLock);
+}
+
+static void ZH_MetalRecordMissingPass(Uint32 category, Uint64 epoch)
+{
+    SDL_LockSpinlock(&ZH_MetalTimingLock);
+    if (epoch == ZH_MetalTimingEpoch && SDL_GetAtomicInt(&ZH_MetalTimingEnabled))
+        ++ZH_MetalPassMissing[category];
+    SDL_UnlockSpinlock(&ZH_MetalTimingLock);
+}
